# Copy to web/.env.local. The quote tool works with none of these set;
# accounts and booking need the three Supabase values.

# --- Supabase (Dashboard → Project Settings → API Keys) ---
# For local dev, `npx supabase start` (in the repo root) prints these.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Used solely to insert jobs after the server recomputes the price.
# Never expose it to the browser or commit it.
SUPABASE_SECRET_KEY=

# --- Map imagery (optional) ---
# Default: Esri World Imagery. Check its terms before commercial launch, or
# switch to a keyed provider such as MapTiler or Google Map Tiles.
# NEXT_PUBLIC_SATELLITE_TILE_URL=
# NEXT_PUBLIC_SATELLITE_ATTRIBUTION=
# NEXT_PUBLIC_LABEL_TILE_URL=

# --- Geocoding (optional) ---
# Contact (email or URL) sent in the User-Agent to OpenStreetMap Nominatim.
# NOMINATIM_CONTACT=
