# All optional — the app works with none of these set.

# Satellite imagery tiles ({z}/{y}/{x} or {z}/{x}/{y} XYZ template).
# Default: Esri World Imagery. Check its terms before commercial launch, or
# switch to a keyed provider such as MapTiler or Google Map Tiles.
# NEXT_PUBLIC_SATELLITE_TILE_URL=
# NEXT_PUBLIC_SATELLITE_ATTRIBUTION=
# NEXT_PUBLIC_LABEL_TILE_URL=

# Contact (email or URL) sent in the User-Agent to OpenStreetMap Nominatim,
# as its usage policy asks.
# NOMINATIM_CONTACT=
